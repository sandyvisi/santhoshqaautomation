<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd" >
<suite name="cross browser and parallel suite" parallel="methods"
	thread-count="5">
	<listeners>
		<!--<listener class-name="utils.ExtentReportManager" /> -->
		<!--<listener class-name="utils.RetryListener" /> -->
	</listeners>
	<test name="Chrome test cases">
		<parameter name="browser" value="chrome"></parameter>
		<groups>
			<run>
				<include name="smoke" />
			</run>
		</groups>
		<classes>
			<class name="testCases.PatientFormTestcases" />
		</classes>
	</test>

	<test name="firefox test cases">
		<parameter name="browser" value="firefox"></parameter>
		<groups>
			<run>
				<include name="smoke" />
			</run>
		</groups>
		<classes>
			<class name="testCases.PatientFormTestcases" />
		</classes>
	</test>
</suite>